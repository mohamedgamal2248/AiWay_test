# Supabase (server only; never expose the service-role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session/JWT signing secret. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
APP_JWT_SECRET=

# Pi Network server API key (payments approve/complete, /me verification)
PI_SECRET_KEY=
PI_API_BASE_URL=https://api.minepi.com

# Meta Model API key from https://dev.meta.ai (OpenAI-compatible, base URL https://api.meta.ai/v1).
# Use the NON-contributor models only (muse-ember-1.0 / muse-image-1.0): contributor
# model ids let Meta use user content to improve its products.
META_API_KEY=

# Agent limits (optional)
# Wall-clock budget of one agent run in ms. Keep it under the function maxDuration (300s).
AGENT_TIME_BUDGET_MS=230000
# Provider USD that AiWay absorbs for one free-trial agent run (owner-funded free quota).
AGENT_TRIAL_BUDGET_USD=0.012

# Optional
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
